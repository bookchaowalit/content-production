# Video Studio web (SPEC-001 R-NONROOT, R-PROXY-2): Next standalone output started through server-launch.mjs,
# which guards every request and sets the long upload timeouts. No API origin or token is built in.
FROM node:22-alpine AS build
WORKDIR /app
COPY apps/video-postproduction-web/package*.json ./
RUN npm ci --no-audit --no-fund
COPY apps/video-postproduction-web/ ./
RUN npm run build \
    && cp -r .next/static .next/standalone/.next/ \
    && (cp -r public .next/standalone/ 2>/dev/null || true) \
    && cp server-launch.mjs .next/standalone/ \
    && mkdir -p .next/standalone/server \
    && cp server/guard.mjs .next/standalone/server/

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
COPY --from=build --chown=10001:10001 /app/.next/standalone ./
USER 10001:10001
EXPOSE 3000
# The guard checks Host even on /healthz, so the probe sends one the current mode allows.
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=6 \
  CMD wget -qO- --header "Host: ${STUDIO_HEALTH_HOST:-127.0.0.1:3400}" http://127.0.0.1:3000/healthz >/dev/null || exit 1
CMD ["node", "server-launch.mjs"]
